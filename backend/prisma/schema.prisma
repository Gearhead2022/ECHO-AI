generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
}

enum MessageRole {
    USER
    ASSISTANT
}

model Conversation {
    id Int @id @default(autoincrement())

    title String?

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    messages Message[]

    @@map("conversation")
}

model Message {
    id Int @id @default(autoincrement())

    conversationId Int

    role MessageRole

    content String @db.LongText

    audioUrl String?

    createdAt DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@map("message")
}

model Memory {
    id Int @id @default(autoincrement())

    key   String
    value String @db.LongText

    category String?

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    @@index([key])
    @@index([category])
    @@map("memory")
}
